{
  "name": "retro-photo-frame-tool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "build:minitool": "tsc -b && vite build --mode minitool --outDir dist-minitool",
