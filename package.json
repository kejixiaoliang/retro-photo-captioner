    "preview": "vite preview --host 127.0.0.1",
    "verify:browser": "node scripts/verify-browser.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "vite": "latest",
    "typescript": "latest",
    "react": "latest",
    "react-dom": "latest",
    "lucide-react": "latest",
    "vitest": "latest",
    "playwright": "latest"
  },
  "devDependencies": {}
}
